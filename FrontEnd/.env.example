# MODE STUDIO - Environment Configuration Example
VITE_API_URL=http://localhost:8000/api

# Phím tắt điều hướng nhanh trong môi trường phát triển (Admin / Design System trên Header, mặc định false)
VITE_SHOW_DEV_SHORTCUTS=false

# Hiển thị khối nhận bản tin (Newsletter) ở Footer (mặc định false)
VITE_ENABLE_NEWSLETTER=false

# Bật phương thức thanh toán online VNPay tại trang Checkout (mặc định false)
VITE_ENABLE_VNPAY=false
